{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Jwt": {
    "Issuer": "https://localhost:7241",
    "Audience": "https://localhost:7241",
    "AccessTokenExpiresIn": 3600,
    "RefreshTokenExpiresIn": 10080
  },

  "Authentication": {
    "Google": {
      "ClientId": "686169921864-rfji39dbmqe3haeimvumla5cetp8k7el.apps.googleusercontent.com"
    }
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromName": "VAcademyConnect"
  },

  "AllowedHosts": "*"
}
